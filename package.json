{
  "name": "blockchain-energy-trading",
  "version": "1.0.0",
  "description": "A decentralized peer-to-peer energy trading platform leveraging blockchain technology, smart contracts, and IoT-enabled smart meters.",
  "main": "hardhat.config.js",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:gas": "REPORT_GAS=true hardhat test",
    "coverage": "hardhat coverage",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "deploy:mainnet": "hardhat run scripts/deploy.js --network mainnet",
    "node": "hardhat node",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "clean": "hardhat clean",
    "format": "prettier --write '**/*.{js,json,sol,md}'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/affrin-19/blockchain-energy-trading.git"
  },
  "keywords": [
    "blockchain",
    "energy-trading",
    "peer-to-peer",
    "smart-contracts",
    "ethereum",
    "solidity",
    "iot",
    "renewable-energy",
    "decentralized",
    "p2p",
    "smart-grid",
    "defi"
  ],
  "author": "Blockchain Energy Trading Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/affrin-19/blockchain-energy-trading/issues"
  },
  "homepage": "https://github.com/affrin-19/blockchain-energy-trading#readme",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "hardhat": "^2.19.0",
    "hardhat-gas-reporter": "^1.0.9",
    "solhint": "^4.0.0",
    "solidity-coverage": "^0.8.5",
    "prettier": "^3.1.0",
    "prettier-plugin-solidity": "^1.3.0",
    "dotenv": "^16.3.1"
  }
}
